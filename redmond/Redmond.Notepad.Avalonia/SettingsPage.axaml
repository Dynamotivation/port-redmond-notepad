<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Redmond.Notepad.Avalonia"
             xmlns:shared="using:Redmond.Avalonia.Controls"
             x:Class="Redmond.Notepad.Avalonia.SettingsPage"
             Background="Transparent">

  <UserControl.Styles>
    <Style Selector="TextBlock.sectionHeading">
      <Setter Property="Margin" Value="0,10,0,6" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Border.spellingRow">
      <Setter Property="Height" Value="56" />
      <Setter Property="BorderBrush" Value="{DynamicResource RedmondSettingsCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="ToggleSwitch.settingToggle">
      <Setter Property="OnContent" Value="On" />
      <Setter Property="OffContent" Value="Off" />
      <Setter Property="IsChecked" Value="True" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="SettingsScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Background="Transparent">
    <Grid x:Name="SettingsLayout"
          Margin="40,30"
          MaxWidth="1320"
          ColumnDefinitions="*,300">
      <StackPanel x:Name="MainSettingsColumn" Spacing="6">
        <TextBlock Margin="0,0,0,22"
                   FontSize="36"
                   FontWeight="SemiBold"
                   Text="Settings" />

        <TextBlock Classes="sectionHeading" Margin="0,0,0,6" Text="Appearance" />
        <shared:AnimatedSettingsExpander Header="App theme"
                                         Description="Select which app theme to display">
          <shared:AnimatedSettingsExpander.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Text="◐" />
          </shared:AnimatedSettingsExpander.Icon>
          <StackPanel Spacing="8">
            <RadioButton x:Name="SystemThemeButton" GroupName="Theme" Content="Use system setting"
                         Click="OnThemeChecked" />
            <RadioButton x:Name="LightThemeButton" GroupName="Theme" Content="Light"
                         Click="OnThemeChecked" />
            <RadioButton x:Name="DarkThemeButton" GroupName="Theme" Content="Dark"
                         Click="OnThemeChecked" />
          </StackPanel>
        </shared:AnimatedSettingsExpander>

        <shared:WindowAppearanceSettingsPanel x:Name="WindowAppearancePanel" />

        <shared:SettingsCard x:Name="NativeMacOSMenuBarCard"
                             Header="macOS menu bar"
                             Description="Move File, Edit, View, and Settings to the system menu bar"
                             IsVisible="False">
          <shared:SettingsCard.Icon>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="17"
                       Text="⌘" />
          </shared:SettingsCard.Icon>
          <ToggleSwitch x:Name="NativeMacOSMenuBarToggle"
                        Classes="settingToggle"
                        Click="OnNativeMacOSMenuBarToggleClick" />
        </shared:SettingsCard>

        <TextBlock Classes="sectionHeading" Text="Text Formatting" />
        <shared:AnimatedSettingsExpander x:Name="FontSettingsExpander"
                                         Header="Font"
                                         Description="Choose the editor font, style, and size">
          <shared:AnimatedSettingsExpander.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" Text="Aa" />
          </shared:AnimatedSettingsExpander.Icon>
          <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="12">
            <ComboBox x:Name="FontFamilyComboBox"
                      SelectionChanged="OnFontSelectionChanged" />
            <ComboBox x:Name="FontStyleComboBox"
                      Grid.Column="1"
                      SelectionChanged="OnFontSelectionChanged">
              <ComboBoxItem Content="Regular" />
              <ComboBoxItem Content="Italic" />
              <ComboBoxItem Content="Bold" />
              <ComboBoxItem Content="Bold Italic" />
            </ComboBox>
            <NumericUpDown x:Name="FontSizeBox"
                           Grid.Column="2"
                           Width="100"
                           Minimum="8"
                           Maximum="72"
                           Increment="1"
                           ValueChanged="OnFontSizeChanged" />
          </Grid>
        </shared:AnimatedSettingsExpander>
        <shared:SettingsCard Header="Word wrap"
                             Description="Fit text within window by default">
          <shared:SettingsCard.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="↩" />
          </shared:SettingsCard.Icon>
          <ToggleSwitch x:Name="WordWrapToggle"
                        Classes="settingToggle"
                        Click="OnWordWrapToggleClick" />
        </shared:SettingsCard>
        <shared:SettingsCard Header="Formatting">
          <shared:SettingsCard.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="✂" />
          </shared:SettingsCard.Icon>
          <ToggleSwitch x:Name="FormattingToggle"
                        Classes="settingToggle"
                        Click="OnFormattingToggleClick" />
        </shared:SettingsCard>

        <TextBlock Classes="sectionHeading" Text="Opening Notepad" />
        <shared:SettingsCard Header="Opening files"
                             Description="Choose where your files are opened">
          <shared:SettingsCard.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Text="↗" />
          </shared:SettingsCard.Icon>
          <ComboBox x:Name="OpeningFilesComboBox"
                    Width="164"
                    SelectionChanged="OnOpeningFilesSelectionChanged">
            <ComboBoxItem Content="Open in a new tab" />
            <ComboBoxItem Content="Open in a new window" />
          </ComboBox>
        </shared:SettingsCard>
        <shared:AnimatedSettingsExpander Header="When Notepad starts">
          <shared:AnimatedSettingsExpander.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Text="□" />
          </shared:AnimatedSettingsExpander.Icon>
          <StackPanel Spacing="8">
            <RadioButton x:Name="NewWindowStartupButton"
                         GroupName="Startup"
                         Content="Open a new window"
                         Click="OnStartupModeChecked" />
            <RadioButton x:Name="ContinueSessionStartupButton"
                         GroupName="Startup"
                         Content="Continue previous session"
                         Click="OnStartupModeChecked" />
          </StackPanel>
        </shared:AnimatedSettingsExpander>
        <shared:SettingsCard Header="Recent Files">
          <shared:SettingsCard.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Text="◷" />
          </shared:SettingsCard.Icon>
          <ToggleSwitch x:Name="RecentFilesToggle"
                        Classes="settingToggle"
                        Click="OnRecentFilesToggleClick" />
        </shared:SettingsCard>

        <TextBlock Classes="sectionHeading" Text="Spelling" />
        <shared:AnimatedSettingsExpander Padding="0"
                                         IsExpanded="True">
          <shared:AnimatedSettingsExpander.Header>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock VerticalAlignment="Center" Text="Spell check" />
              <ToggleSwitch x:Name="SpellCheckToggle"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Classes="settingToggle"
                            Click="OnSpellingToggleClick" />
            </Grid>
          </shared:AnimatedSettingsExpander.Header>
          <shared:AnimatedSettingsExpander.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Text="ABC✓" />
          </shared:AnimatedSettingsExpander.Icon>
          <StackPanel>
            <Border Classes="spellingRow">
              <Grid Margin="68,0,16,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text=".txt" />
                <ToggleSwitch x:Name="TxtSpellCheckToggle"
                              Grid.Column="1"
                              Classes="settingToggle"
                              Click="OnSpellingToggleClick" />
              </Grid>
            </Border>
            <Border Classes="spellingRow">
              <Grid Margin="68,0,16,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text=".md" />
                <ToggleSwitch x:Name="MarkdownSpellCheckToggle"
                              Grid.Column="1"
                              Classes="settingToggle"
                              Click="OnSpellingToggleClick" />
              </Grid>
            </Border>
            <Border Classes="spellingRow">
              <Grid Margin="68,0,16,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text=".srt / .ass" />
                <ToggleSwitch x:Name="SubtitleSpellCheckToggle"
                              Grid.Column="1"
                              Classes="settingToggle"
                              Click="OnSpellingToggleClick" />
              </Grid>
            </Border>
            <Border Classes="spellingRow">
              <Grid Margin="68,0,16,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text=".lrc" />
                <ToggleSwitch x:Name="LyricsSpellCheckToggle"
                              Grid.Column="1"
                              Classes="settingToggle"
                              Click="OnSpellingToggleClick" />
              </Grid>
            </Border>
            <Border Classes="spellingRow">
              <Grid Margin="68,0,16,0" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Text=".lic" />
                <ToggleSwitch x:Name="LicenseSpellCheckToggle"
                              Grid.Column="1"
                              Classes="settingToggle"
                              Click="OnSpellingToggleClick" />
              </Grid>
            </Border>
          </StackPanel>
        </shared:AnimatedSettingsExpander>
        <shared:SettingsCard Header="Autocorrect"
                             Description="Choose how typing mistakes are handled">
          <shared:SettingsCard.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="✎" />
          </shared:SettingsCard.Icon>
          <ComboBox x:Name="AutocorrectModeComboBox"
                    Width="190"
                    SelectionChanged="OnAutocorrectModeSelectionChanged">
            <ComboBoxItem Content="Never correct automatically" />
            <ComboBoxItem Content="Fix common typing mistakes" />
            <ComboBoxItem Content="Fix spelling mistakes automatically" />
          </ComboBox>
        </shared:SettingsCard>

        <TextBlock Classes="sectionHeading" Text="Advanced Features" />
        <shared:SettingsCard Header="Writing tools">
          <shared:SettingsCard.Icon>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="✣" />
          </shared:SettingsCard.Icon>
          <ToggleSwitch Classes="settingToggle" />
        </shared:SettingsCard>

        <local:AboutSettingsPanel x:Name="NarrowAboutPanel"
                                  Margin="0,22,0,12"
                                  IsVisible="False" />
      </StackPanel>

      <local:AboutSettingsPanel x:Name="WideAboutPanel"
                                Grid.Column="1"
                                Margin="56,74,0,0" />
    </Grid>
  </ScrollViewer>
</UserControl>
