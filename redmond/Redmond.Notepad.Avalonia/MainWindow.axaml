<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Redmond.Notepad.Avalonia"
        xmlns:shared="using:Redmond.Avalonia.Controls"
        xmlns:avaloniaEdit="using:AvaloniaEdit"
        x:Class="Redmond.Notepad.Avalonia.MainWindow"
        Title="Untitled - Notepad"
        Width="900"
        Height="600"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Icon="avares://Redmond%20Notepad/Assets/RedmondNotepadIcon.png"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="#F3F3F3">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <!--
            Interaction colors are translucent overlays. Over the measured
            opaque surfaces they composite to the Windows Notepad reference:
            #0EFFFFFF over #202020 -> #2C2C2C (tab hover)
            #0FFFFFFF over #2C2C2C -> #383838 (button hover)
          -->
          <SolidColorBrush x:Key="ChromeHoverBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="TabHoverBrush" Color="#0EFFFFFF" />
          <SolidColorBrush x:Key="NotepadTitleBarBrush" Color="#202020" />
          <SolidColorBrush x:Key="NotepadSelectedTabBrush" Color="#2C2C2C" />
          <SolidColorBrush x:Key="NotepadMenuBarBrush" Color="#2C2C2C" />
          <SolidColorBrush x:Key="NotepadEditorBrush" Color="#272727" />
          <SolidColorBrush x:Key="NotepadStatusBrush" Color="#2C2C2C" />
          <SolidColorBrush x:Key="NotepadDividerBrush" Color="#3D3D3D" />
          <SolidColorBrush x:Key="NotepadSecondaryForegroundBrush" Color="#CFCFCF" />
          <SolidColorBrush x:Key="NotepadSelectedForegroundBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="NotepadMenuForegroundBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="NotepadEditorForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NotepadMicaRaisedSurfaceBrush" Color="#0EFFFFFF" />
          <SolidColorBrush x:Key="NotepadMicaDividerBrush" Color="#15FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ChromeHoverBrush" Color="#11000000" />
          <SolidColorBrush x:Key="TabHoverBrush" Color="#0E000000" />
          <SolidColorBrush x:Key="NotepadTitleBarBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="NotepadSelectedTabBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NotepadMenuBarBrush" Color="#F9F9F9" />
          <SolidColorBrush x:Key="NotepadEditorBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NotepadStatusBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="NotepadDividerBrush" Color="#D8D8D8" />
          <SolidColorBrush x:Key="NotepadSecondaryForegroundBrush" Color="#5E5E5E" />
          <SolidColorBrush x:Key="NotepadSelectedForegroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="NotepadMenuForegroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="NotepadEditorForegroundBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="NotepadMicaRaisedSurfaceBrush" Color="#0E000000" />
          <SolidColorBrush x:Key="NotepadMicaDividerBrush" Color="#15000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="RedmondFluentIconFont">avares://Redmond.Avalonia.Controls/Assets/RedmondFluentIcons.ttf#Calculator Fluent Icons</FontFamily>
      <x:String x:Key="CloseTabToolTip">Close tab</x:String>
      <x:String x:Key="NewTabToolTip">New tab</x:String>
      <x:String x:Key="SettingsToolTip">Settings</x:String>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
    </Style>
    <Style Selector="Button.menuCommand">
      <Setter Property="Foreground" Value="{DynamicResource NotepadMenuForegroundBrush}" />
    </Style>
    <Style Selector="Menu.documentMenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Menu.documentMenu > MenuItem">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NotepadMenuForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Menu.documentMenu > MenuItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
    </Style>
    <Style Selector="Menu.documentMenu > MenuItem[IsSubMenuOpen=true]">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
    </Style>
    <!-- The 38 px command row contains 32 px menu headers inside a 3 px
         vertical inset, so another 3 px places the popup on the editor edge. -->
    <Style Selector="Menu.documentMenu > MenuItem /template/ Popup#PART_Popup">
      <Setter Property="VerticalOffset" Value="3" />
    </Style>
    <!-- Keep Avalonia's stock Fluent submenu chevron, only reducing its
         vertical extent to match the more compact Windows Notepad glyph. -->
    <Style Selector="Path#PART_ChevronPath">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1,0.6)" />
    </Style>
    <!-- Avalonia's Fluent theme gives checked-menu glyphs a 16 px presenter.
         Preserve its 28 px column footprint while centering a 12 px glyph. -->
    <Style Selector="MenuItem /template/ ContentControl#PART_ToggleIconPresenter">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="2,0,14,0" />
    </Style>
    <Style Selector="Separator.menuDivider">
      <Setter Property="Height" Value="1" />
      <Setter Property="MinHeight" Value="1" />
      <Setter Property="Margin" Value="-4,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource NotepadDividerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NotepadDividerBrush}" />
    </Style>
    <Style Selector="Button.tabGlyph">
      <Setter Property="Foreground" Value="{DynamicResource NotepadSecondaryForegroundBrush}" />
    </Style>
    <Style Selector="Button.tabGlyph:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource NotepadSelectedForegroundBrush}" />
    </Style>
    <Style Selector="RepeatButton.chrome">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="RepeatButton.chrome:pointerover">
      <Setter Property="Background" Value="{DynamicResource ChromeHoverBrush}" />
    </Style>
    <Style Selector="RepeatButton.tabChevron">
      <Setter Property="Foreground" Value="{DynamicResource NotepadSecondaryForegroundBrush}" />
    </Style>
    <Style Selector="ListBox.tabStrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="ZIndex" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <ItemsPresenter Name="PART_ItemsPresenter"
                          Margin="{TemplateBinding Padding}"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.tabStrip ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource NotepadSecondaryForegroundBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.tabStrip ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource TabHoverBrush}" />
    </Style>
    <Style Selector="ListBox.tabStrip ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource NotepadSelectedTabBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NotepadSelectedForegroundBrush}" />
      <Setter Property="ToolTip.Tip" Value="{ReflectionBinding Title}" />
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="ListBox.tabStrip ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource NotepadSelectedTabBrush}" />
    </Style>
    <Style Selector="ListBox.tabStrip ListBoxItem:selected:focus">
      <Setter Property="Background" Value="{DynamicResource NotepadSelectedTabBrush}" />
    </Style>
    <Style Selector="Border.menuSurface">
      <Setter Property="Background" Value="{DynamicResource NotepadMenuBarBrush}" />
    </Style>
    <Style Selector="Border.editorSurface">
      <Setter Property="Background" Value="{DynamicResource NotepadEditorBrush}" />
    </Style>
    <Style Selector="Border.statusSurface">
      <Setter Property="Background" Value="{DynamicResource NotepadStatusBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NotepadDividerBrush}" />
    </Style>
    <Style Selector="Border.windowSurface.backdrop Border.menuSurface">
      <Setter Property="Background" Value="{DynamicResource NotepadMicaRaisedSurfaceBrush}" />
    </Style>
    <Style Selector="Border.windowSurface.backdrop Border.statusSurface">
      <Setter Property="Background" Value="{DynamicResource NotepadMicaRaisedSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NotepadMicaDividerBrush}" />
    </Style>
    <Style Selector="Border.statusSurface TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NotepadSecondaryForegroundBrush}" />
    </Style>
    <Style Selector="Button.changeBack">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Background" Value="{DynamicResource NotepadSelectedTabBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NotepadSelectedForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NotepadDividerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Button.changeBack:pointerover">
      <Setter Property="Background" Value="{DynamicResource TabHoverBrush}" />
    </Style>
    <Style Selector="Border.windowSurface.backdrop Border.tabSeparator">
      <Setter Property="Background" Value="{DynamicResource NotepadMicaDividerBrush}" />
    </Style>
    <Style Selector="Border.windowSurface.backdrop ListBox.tabStrip ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource NotepadMicaRaisedSurfaceBrush}" />
    </Style>
  </Window.Styles>

  <Grid>
  <Border x:Name="WindowSurface"
          Classes="windowSurface"
          Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
          BorderThickness="1"
          CornerRadius="8"
          ClipToBounds="True">
  <Grid RowDefinitions="Auto,38,*,27">
    <Grid x:Name="DocumentTitleBar"
          Height="48"
          Background="{DynamicResource NotepadTitleBarBrush}">
      <shared:WindowDragRegion />
      <Grid x:Name="TitleBarContent"
            Height="37"
            VerticalAlignment="Bottom"
            ColumnDefinitions="Auto,*"
            Margin="8,0,0,0">
        <Grid Width="37" Height="37">
          <Image Width="20"
                 Height="22"
                 Stretch="Uniform"
                 IsHitTestVisible="False"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Source="avares://Redmond%20Notepad/Assets/RedmondNotepadIcon.png" />
        </Grid>
        <Grid x:Name="TabBarArea"
              Grid.Column="1"
              SizeChanged="OnTabBarSizeChanged">
          <Grid x:Name="TabBarControls"
                HorizontalAlignment="Left"
                ColumnDefinitions="Auto,*,Auto,Auto">
          <RepeatButton x:Name="TabScrollLeftButton"
                        Classes="chrome tabChevron"
                        Width="28"
                        Height="28"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="False"
                        Delay="280"
                        Interval="16"
                        Click="OnTabScrollLeftClick"
                        ToolTip.Tip="Scroll tab list backward"
                        AutomationProperties.Name="Scroll tab list backward">
            <Path Width="7" Height="12" Stretch="Fill"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                  Data="M 7,1 L 2,6 L 7,11 Z" />
          </RepeatButton>

          <ScrollViewer x:Name="TabScrollViewer"
                        Grid.Column="1"
                        Height="37"
                        HorizontalAlignment="Left"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        IsScrollChainingEnabled="False"
                        ScrollChanged="OnTabScrollChanged">
            <ListBox x:Name="TabsList"
                       Classes="tabStrip"
                       Height="37"
                       HorizontalAlignment="Left"
                       SelectionMode="Single"
                       SelectionChanged="OnTabSelectionChanged"
                       PointerCaptureLost="OnTabsPointerCaptureLost">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Grid Width="{Binding LayoutWidth}"
                          Height="37"
                          Opacity="{Binding DragOpacity}"
                          ColumnDefinitions="*,34">
                      <TextBlock Margin="12,0,4,0"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Title}" />
                      <Button Grid.Column="1"
                              Classes="chrome tabGlyph"
                              Width="28"
                              Height="28"
                              Padding="0"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              CommandParameter="{Binding}"
                              Click="OnCloseTabClick"
                              ToolTip.Tip="{DynamicResource CloseTabToolTip}"
                              AutomationProperties.Name="Close tab">
                        <Grid>
                          <Path Width="10"
                                Height="10"
                                IsVisible="{Binding ShowCloseGlyph}"
                                Stretch="Uniform"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="1.4"
                                StrokeLineCap="Round"
                                Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                          <Ellipse Width="5"
                                   Height="5"
                                   IsVisible="{Binding ShowModifiedGlyph}"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Grid>
                      </Button>
                      <Border Grid.ColumnSpan="2"
                              Classes="tabSeparator"
                              Width="1"
                              Height="22.2"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              IsVisible="{Binding ShowLeadingSeparator}"
                              Background="{DynamicResource NotepadDividerBrush}" />
                      <Border Grid.ColumnSpan="2"
                              Classes="tabSeparator"
                              Width="1"
                              Height="22.2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              IsVisible="{Binding ShowTrailingSeparator}"
                              Background="{DynamicResource NotepadDividerBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
          </ScrollViewer>

          <RepeatButton x:Name="TabScrollRightButton"
                        Grid.Column="2"
                        Classes="chrome tabChevron"
                        Width="28"
                        Height="28"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="False"
                        Delay="280"
                        Interval="16"
                        Click="OnTabScrollRightClick"
                        ToolTip.Tip="Scroll tab list forward"
                        AutomationProperties.Name="Scroll tab list forward">
            <Path Width="7" Height="12" Stretch="Fill"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                  Data="M 1,1 L 6,6 L 1,11 Z" />
          </RepeatButton>

          <Grid Grid.Column="3" Width="37" Height="37">
            <Button Classes="chrome tabGlyph"
                    Width="28"
                    Height="28"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnNewTabClick"
                    ToolTip.Tip="{DynamicResource NewTabToolTip}"
                    AutomationProperties.Name="New tab">
              <Path Width="12"
                    Height="12"
                    Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.4"
                    StrokeLineCap="Round"
                    Data="M 6,0 L 6,12 M 0,6 L 12,6" />
            </Button>
          </Grid>
          </Grid>
          <Border x:Name="TabDropIndicator"
                  Width="2"
                  Height="29"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,1"
                  Background="{DynamicResource SystemAccentColor}"
                  CornerRadius="1"
                  IsHitTestVisible="False"
                  IsVisible="False"
                  ZIndex="20" />
        </Grid>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsTitleBar" Height="42" IsVisible="False">
      <shared:WindowDragRegion BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                               BorderThickness="0,0,0,1" />
      <Grid x:Name="SettingsTitleBarContent"
            Height="42"
            ColumnDefinitions="44,Auto,*"
            Margin="8,0,0,0">
        <Button Classes="chrome"
                Width="36"
                Height="36"
                Padding="0"
                Click="OnBackFromSettingsClick"
                AutomationProperties.Name="Back">
          <Path Width="18" Height="18" Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.25"
                Data="M 12.5,5.5 L 6,12 L 12.5,18.5 M 6,12 L 20,12" />
        </Button>
        <Image Grid.Column="1"
               Width="20"
               Height="20"
               Margin="0,0,10,0"
               Stretch="Uniform"
               IsHitTestVisible="False"
               VerticalAlignment="Center"
               Source="avares://Redmond%20Notepad/Assets/RedmondNotepadIcon.png" />
        <TextBlock Grid.Column="2"
                   IsHitTestVisible="False"
                   VerticalAlignment="Center"
                   FontSize="13"
                   Text="Notepad" />
      </Grid>
    </Grid>

    <Grid x:Name="DocumentPage"
          Grid.Row="1"
          Grid.RowSpan="3">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="DocumentMenuBarHost"
            Grid.Row="0"
            Classes="menuSurface">
    <Grid x:Name="DocumentMenuBar"
          ColumnDefinitions="*,Auto"
          Margin="7,3">
      <Menu Classes="documentMenu">
        <MenuItem Header="File" SubmenuOpened="OnFileMenuOpened">
              <MenuItem x:Name="NewTabMenuItem" Header="New tab" Click="OnNewTabClick" />
              <MenuItem x:Name="NewWindowMenuItem" Header="New window" Click="OnNewWindowClick" />
              <MenuItem x:Name="NewMarkdownTabMenuItem" Header="New Markdown tab" IsEnabled="False" />
              <MenuItem x:Name="OpenMenuItem" Header="Open" Click="OnOpenFilesClick" />
              <MenuItem x:Name="RecentFilesMenuItem" Header="Recent" />
              <MenuItem x:Name="SaveMenuItem" Header="Save" Click="OnSaveClick" />
              <MenuItem x:Name="SaveAsMenuItem" Header="Save as" Click="OnSaveAsClick" />
              <MenuItem x:Name="SaveAllMenuItem" Header="Save all" Click="OnSaveAllClick" />
              <Separator Classes="menuDivider" />
              <MenuItem Header="Page setup" Click="OnPageSetupClick" />
              <MenuItem x:Name="PrintMenuItem" Header="Print" Click="OnPrintClick" />
              <Separator Classes="menuDivider" />
              <MenuItem x:Name="CloseTabMenuItem" Header="Close tab" Click="OnCloseSelectedTabClick" />
              <MenuItem x:Name="CloseWindowMenuItem" Header="Close window" Click="OnCloseWindowClick" />
              <MenuItem Header="Exit" Click="OnExitClick" />
        </MenuItem>
        <MenuItem Header="Edit" SubmenuOpened="OnEditMenuOpened">
              <MenuItem x:Name="UndoMenuItem" Header="Undo" Click="OnUndoClick" />
              <Separator Classes="menuDivider" />
              <MenuItem x:Name="CutMenuItem" Header="Cut" Click="OnCutClick" />
              <MenuItem x:Name="CopyMenuItem" Header="Copy" Click="OnCopyClick" />
              <MenuItem x:Name="PasteMenuItem" Header="Paste" Click="OnPasteClick" />
              <MenuItem x:Name="DeleteMenuItem" Header="Delete" Click="OnDeleteClick" />
              <Separator Classes="menuDivider" />
              <MenuItem x:Name="ClearFormattingMenuItem" Header="Clear formatting" IsEnabled="False" />
              <Separator Classes="menuDivider" />
              <MenuItem x:Name="FindMenuItem" Header="Find" Click="OnFindClick" />
              <MenuItem x:Name="FindNextMenuItem" Header="Find next" Click="OnFindNextClick" />
              <MenuItem x:Name="FindPreviousMenuItem" Header="Find previous" Click="OnFindPreviousClick" />
              <MenuItem x:Name="ReplaceMenuItem" Header="Replace" Click="OnReplaceClick" />
              <MenuItem x:Name="GoToMenuItem" Header="Go to" Click="OnGoToClick" />
              <Separator Classes="menuDivider" />
              <MenuItem x:Name="SelectAllMenuItem" Header="Select all" Click="OnSelectAllClick" />
              <MenuItem x:Name="TimeDateMenuItem" Header="Time/Date" Click="OnTimeDateClick" />
              <Separator Classes="menuDivider" />
              <MenuItem Header="Font" Click="OnFontClick" />
        </MenuItem>
        <MenuItem Header="View" SubmenuOpened="OnViewMenuOpened">
              <MenuItem Header="Zoom">
                <MenuItem x:Name="ZoomInMenuItem" Header="Zoom in" Click="OnZoomInClick" />
                <MenuItem x:Name="ZoomOutMenuItem" Header="Zoom out" Click="OnZoomOutClick" />
                <MenuItem x:Name="RestoreZoomMenuItem"
                          Header="Restore default zoom"
                          Click="OnRestoreZoomClick" />
              </MenuItem>
              <MenuItem x:Name="StatusBarMenuItem"
                        Header="Status bar"
                        ToggleType="CheckBox"
                        Click="OnStatusBarClick" />
              <MenuItem x:Name="WordWrapMenuItem"
                        Header="Word wrap"
                        ToggleType="CheckBox"
                        Click="OnWordWrapClick" />
              <MenuItem x:Name="MarkdownMenuItem" Header="Markdown" IsEnabled="False">
                <MenuItem Header="Markdown options unavailable" IsEnabled="False" />
              </MenuItem>
        </MenuItem>
      </Menu>
      <Button Grid.Column="1"
              Classes="chrome menuCommand"
              Width="36"
              Height="32"
              Padding="0"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Click="OnSettingsClick"
              ToolTip.Tip="{DynamicResource SettingsToolTip}"
              AutomationProperties.Name="Settings">
        <TextBlock FontFamily="{StaticResource RedmondFluentIconFont}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="17"
                   Text="&#xE713;" />
      </Button>
    </Grid>
    </Border>

    <Border Grid.Row="1"
            Classes="editorSurface"
            Padding="14,10">
      <Grid x:Name="EditorOverlay">
        <avaloniaEdit:TextEditor x:Name="Editor"
                                 Background="Transparent"
                                 Foreground="{DynamicResource NotepadEditorForegroundBrush}"
                                 WordWrap="True"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                                 FontSize="14"
                                 AutomationProperties.Name="Text editor">
          <avaloniaEdit:TextEditor.ContextMenu>
            <ContextMenu x:Name="EditorContextMenu"
                         Opened="OnEditorContextMenuOpened">
              <MenuItem Header="Select all" />
            </ContextMenu>
          </avaloniaEdit:TextEditor.ContextMenu>
        </avaloniaEdit:TextEditor>
        <Button x:Name="ChangeBackButton"
                Classes="changeBack"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsVisible="False"
                Click="OnChangeBackClick"
                AutomationProperties.Name="Change autocorrected word back" />
      </Grid>
    </Border>

    <Border x:Name="StatusBar"
            Classes="statusSurface"
            Grid.Row="2"
            Height="27"
            BorderThickness="0,1,0,0">
      <Grid Margin="12,0"
            ColumnDefinitions="*,Auto,Auto,Auto,Auto"
            VerticalAlignment="Center">
        <TextBlock x:Name="DocumentSummary"
                   FontSize="12"
                   Text="1 line · 0 characters" />
        <TextBlock x:Name="CursorStatus"
                   Grid.Column="1"
                   Margin="14,0"
                   FontSize="12"
                   Text="Ln 1, Col 1" />
        <TextBlock x:Name="ZoomStatus"
                   Grid.Column="2"
                   Margin="14,0"
                   FontSize="12"
                   Text="100%" />
        <TextBlock x:Name="LineEndingStatus"
                   Grid.Column="3"
                   Margin="14,0"
                   FontSize="12"
                   Text="Windows (CRLF)" />
        <TextBlock x:Name="EncodingStatus"
                   Grid.Column="4"
                   Margin="14,0,2,0"
                   FontSize="12"
                   Text="UTF-8" />
      </Grid>
    </Border>
    </Grid>

    <local:SettingsPage x:Name="SettingsPage"
                        Grid.Row="1"
                        Grid.RowSpan="3"
                        IsVisible="False" />

    <shared:WindowCaptionButtons x:Name="CaptionButtons"
                                 Grid.Row="0"
                                 ZIndex="2"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top" />
  </Grid>
  </Border>
  <shared:WindowResizeHandles x:Name="ResizeHandles" />

  <Border x:Name="UnsavedChangesOverlay"
          ZIndex="20"
          IsVisible="False"
          Background="#66000000">
    <Border Width="440"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource NotepadEditorBrush}"
            BorderBrush="{DynamicResource NotepadDividerBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="14">
        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="Save changes?" />
        <TextBlock x:Name="UnsavedChangesMessage"
                   TextWrapping="Wrap" />
        <StackPanel Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button Content="Cancel"
                  Click="OnCancelUnsavedChangesClick" />
          <Button Content="Don't save"
                  Click="OnDiscardUnsavedChangesClick" />
          <Button x:Name="SaveUnsavedChangesButton"
                  Content="Save"
                  Click="OnSaveUnsavedChangesClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <Border x:Name="ExternalChangesOverlay"
          ZIndex="21"
          IsVisible="False"
          Background="#66000000">
    <Border Width="520"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource NotepadEditorBrush}"
            BorderBrush="{DynamicResource NotepadDividerBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="14">
        <TextBlock x:Name="ExternalChangesTitle"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="File changed outside Redmond Notepad" />
        <TextBlock x:Name="ExternalChangesMessage"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ExternalChangesWarning"
                   Opacity="0.72"
                   Text="Reload discards your edits. Overwrite permanently replaces the other version."
                   TextWrapping="Wrap" />
        <StackPanel Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button Content="Cancel"
                  Click="OnCancelExternalChangesClick" />
          <Button x:Name="ReloadExternalChangesButton"
                  Content="Reload"
                  Click="OnReloadExternalChangesClick" />
          <Button x:Name="OverwriteExternalChangesButton"
                  Content="Overwrite"
                  Click="OnOverwriteExternalChangesClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>

  <Border x:Name="GoToOverlay"
          ZIndex="22"
          IsVisible="False"
          Background="#66000000">
    <Border Width="360"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource NotepadEditorBrush}"
            BorderBrush="{DynamicResource NotepadDividerBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="14">
        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="Go to line" />
        <TextBlock x:Name="GoToLineRangeText"
                   Opacity="0.72"
                   Text="Line number" />
        <TextBox x:Name="GoToLineTextBox"
                 AutomationProperties.Name="Line number" />
        <StackPanel Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button Content="Cancel" Click="OnCancelGoToClick" />
          <Button Content="Go to" Click="OnConfirmGoToClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
